    "k299": "ದಯವಿಟ್ಟು ಮೇಲಿನ ಅಂಶಗಳನ್ನು ತಿಳಿಸಿ ಮತ್ತು ಕೆಳಗಿನ \"ಪರಿಶೀಲನೆಗಾಗಿ ಉಳಿಸಿ ಮತ್ತು ಮರುಸಲ್ಲಿಸು\" ಕ್ಲಿಕ್ ಮಾಡಿ.",
    "k300": "ಈ ಲೇಖನವನ್ನು ಏಕೆ ಪ್ರಕಟಿಸಲಾಗುವುದಿಲ್ಲ ಎಂಬುದನ್ನು ವಿವರಿಸಲು ದಯವಿಟ್ಟು ನಿರ್ದಿಷ್ಟವಾದ, ಕಾರ್ಯಸಾಧ್ಯವಾದ ಕಾರಣವನ್ನು ಒದಗಿಸಿ. ಈ ವಿವರಣೆಯನ್ನು ಆಡಿಟ್ ಲಾಗ್‌ನಲ್ಲಿ ದಾಖಲಿಸಲಾಗುತ್ತದೆ ಮತ್ತು ಲೇಖಕರಿಗೆ ಒದಗಿಸಲಾಗುತ್ತದೆ.",
    "k301": "ಪೋಸ್ಟ್ ಐಡಿ:",
    "k302": "ಪೋಸ್ಟ್ ಮಾಡಲಾಗಿದೆ:",
    "k303": "ಹಿಂದಿನ",
    "k304": "ಮೂಲಕ ಸಂಸ್ಕರಿಸಲಾಗಿದೆ",
    "k305": "ಬೆಳೆ ನೀರಿನ ಅವಶ್ಯಕತೆಗಳು ಮತ್ತು ಸಂಭಾವ್ಯ ಸಂರಕ್ಷಣೆ ಪ್ರಯೋಜನಗಳನ್ನು ಅಂದಾಜು ಮಾಡಲು ನಿಮ್ಮ ಬೆಳೆ ವಿಸ್ತೀರ್ಣ ಮತ್ತು ಪ್ರಸ್ತುತ ನೀರಾವರಿ ವಿಧಾನವನ್ನು ಒದಗಿಸಿ.",
    "k306": "ನಿಮ್ಮ ಕುಟುಂಬದ ಗಾತ್ರವನ್ನು ಒದಗಿಸಿ ಮತ್ತು ವಾರ್ಷಿಕ ಬಳಕೆ ಮತ್ತು ಉಳಿತಾಯದ ಮಾದರಿಗೆ ನೀರು-ಉಳಿತಾಯ ನೆಲೆವಸ್ತುಗಳನ್ನು ಆಯ್ಕೆಮಾಡಿ.",
    "k307": "ಸಮುದಾಯಗಳು ನೀರಿನ ಒತ್ತಡವನ್ನು ಜಯಿಸಲು ಸಹಾಯ ಮಾಡಲು ನಿಮ್ಮ ನೀರಿನ-ಸಮರ್ಥ ತಂತ್ರಗಳು, ಕೇಸ್ ಸ್ಟಡೀಸ್ ಅಥವಾ ನೀರಾವರಿ ವೇಳಾಪಟ್ಟಿಗಳನ್ನು ಪ್ರಕಟಿಸಿ.",
    "k308": "ಪ್ರಕಟಿತ ಮತ್ತು ಲೈವ್",
    "k309": "ಪ್ರಕಟಿಸಲಾಗಿದೆ (",
